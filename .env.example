# Copia este archivo a .env y ajusta los valores. .env está gitignorado.
# Variables de entorno soportadas (prefijo FORGE_). Sobreescriben forge.config.toml.
# El separador de secciones anidadas es doble guion bajo: FORGE_<SECCION>__<CAMPO>.

FORGE_PROFILE=auto
FORGE_MODEL_PATH=models/qwen2.5-coder-3b-instruct-q4_k_m.gguf
FORGE_UI__PORT=7860
FORGE_LOG_LEVEL=info

# RAG externo (port-rag-potty). Ver docs/rag-integration.md y ADR-0001.
FORGE_RAG__BASE_URL=http://localhost:8765
# Ruta al repo clonado del RAG (build context del servicio forge-rag en compose).
RAG_REPO_PATH=../port-rag-potty
